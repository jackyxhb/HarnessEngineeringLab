{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HELab Anchor Record",
    "type": "object",
    "required": [
        "id",
        "title",
        "what",
        "why",
        "target",
        "background",
        "date"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^A\\d+$"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "what": {
            "type": "string",
            "minLength": 1
        },
        "why": {
            "type": "string",
            "minLength": 1
        },
        "target": {
            "type": "string",
            "minLength": 1
        },
        "background": {
            "type": "string",
            "minLength": 1
        },
        "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
    },
    "additionalProperties": false
}