{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Artifacts Storage Schema",
  "description": "Canonical storage layout for task-keyed outputs (P1-05, P0-04)",
  "type": "object",
  "required": ["task_id", "created_at", "artifacts"],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique task identifier from task-state.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp of task artifact creation"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "type", "path"],
        "properties": {
          "artifact_id": {
            "type": "string",
            "description": "Unique identifier for this artifact"
          },
          "type": {
            "type": "string",
            "enum": ["commit", "file", "plan", "report", "audit-trail", "context-summary"],
            "description": "Artifact category"
          },
          "path": {
            "type": "string",
            "description": "Absolute path or reference in repository"
          },
          "size_bytes": {
            "type": "integer",
            "description": "Size in bytes if applicable"
          },
          "hash": {
            "type": "string",
            "description": "SHA256 hash for integrity verification"
          },
          "retention_days": {
            "type": "integer",
            "description": "Days to retain before cleanup"
          }
        }
      }
    },
    "task_status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "failed"],
      "description": "Final status of task"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "action": { "type": "string" },
          "agent_id": { "type": "string" },
          "result": { "type": "string" }
        }
      },
      "description": "Chronological log of task actions"
    }
  }
}
