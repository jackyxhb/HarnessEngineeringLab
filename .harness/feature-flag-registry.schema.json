{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HELab Feature Flag Registry",
  "description": "Standardized feature flag configuration for middleware removal protocol (P0-6). Defines toggleable middleware components and their dependency relationships.",
  "type": "object",
  "required": [
    "version",
    "registry_id",
    "generated_at",
    "flags"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^feature-flag-registry-[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Unique identifier for this registry snapshot"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when registry was generated"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flag_id",
          "component_name",
          "enabled",
          "middleware_type"
        ],
        "properties": {
          "flag_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[a-z0-9-]+$",
            "description": "Unique identifier for this flag (e.g., FF-middleware-auth)"
          },
          "component_name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable name of middleware component"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether this middleware is currently active"
          },
          "middleware_type": {
            "type": "string",
            "enum": [
              "prompt-header",
              "tool-wrapper",
              "gate-check",
              "transformation",
              "routing",
              "serialization"
            ],
            "description": "Category of middleware"
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of flag_ids this flag depends on"
          },
          "cascade_on_disable": {
            "type": "boolean",
            "description": "If true, disabling this flag disables all dependents"
          },
          "removal_protocol": {
            "type": "object",
            "properties": {
              "test_harness": {
                "type": "string",
                "description": "Path to test suite that validates removal safety"
              },
              "removal_checklist": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Steps to safely remove this middleware"
              },
              "rollback_safety_window_seconds": {
                "type": "integer",
                "minimum": 60,
                "description": "Time window within which rollback is safe"
              }
            }
          },
          "added_at": {
            "type": "string",
            "format": "date",
            "description": "Date flag was introduced"
          },
          "notes": {
            "type": "string",
            "description": "Implementation notes or removal rationale"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
