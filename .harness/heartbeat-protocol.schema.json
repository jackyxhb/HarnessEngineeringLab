{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HELab Heartbeat Protocol",
  "description": "Standardized heartbeat signals for P0-7 escalation policies. Enables loop detection, progress tracking, and automated escalation triggers.",
  "type": "object",
  "required": [
    "version",
    "heartbeat_id",
    "agent_id",
    "task_id",
    "timestamp",
    "status",
    "progress_indicator"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version"
    },
    "heartbeat_id": {
      "type": "string",
      "pattern": "^hb-[a-z0-9]{8}-[a-z0-9]{4}$",
      "description": "Unique heartbeat identifier"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of agent emitting heartbeat"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of task being executed"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of heartbeat emission"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "waiting",
        "blocked",
        "degraded",
        "stalled"
      ],
      "description": "Current agent operational state"
    },
    "progress_indicator": {
      "type": "object",
      "required": [
        "steps_completed",
        "steps_expected",
        "percent_complete"
      ],
      "properties": {
        "steps_completed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of task steps completed"
        },
        "steps_expected": {
          "type": "integer",
          "minimum": 0,
          "description": "Total expected steps"
        },
        "percent_complete": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Estimated percent task completion"
        },
        "last_step_label": {
          "type": ["string", "null"],
          "description": "Description of most recent completed step"
        }
      }
    },
    "elapsed_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds elapsed since task start"
    },
    "escalation_triggers": {
      "type": "object",
      "description": "Current escalation trigger states",
      "properties": {
        "consecutive_failures": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of consecutive failures on same step"
        },
        "max_failures_before_escalate": {
          "type": "integer",
          "minimum": 1,
          "description": "Threshold for escalation (typically 3)"
        },
        "elapsed_time_limit_seconds": {
          "type": ["integer", "null"],
          "minimum": 60,
          "description": "Maximum allowed elapsed time before escalation"
        },
        "loop_detection_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of loop cycles detected"
        },
        "max_loop_cycles": {
          "type": "integer",
          "minimum": 1,
          "description": "Threshold for loop-detection escalation"
        }
      }
    },
    "escalation_recommended": {
      "type": "boolean",
      "description": "Whether escalation criteria are currently met"
    },
    "escalation_reason": {
      "type": ["string", "null"],
      "description": "If escalation_recommended=true, the reason"
    },
    "audit_trail_location": {
      "type": "string",
      "description": "Path to audit log or escalation-events.jsonl entry"
    },
    "context_snapshot": {
      "type": "object",
      "description": "Optional lightweight state snapshot for escalation context",
      "properties": {
        "current_step": { "type": ["string", "null"] },
        "last_error": { "type": ["string", "null"] },
        "memory_usage_estimate_mb": { "type": ["number", "null"] }
      }
    }
  },
  "additionalProperties": false
}
