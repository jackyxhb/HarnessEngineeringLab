{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HELab Inquiry Response Record",
    "type": "object",
    "required": [
        "inquiry_id",
        "task_id",
        "questions",
        "clarity_score_before",
        "clarity_score_after",
        "timestamp"
    ],
    "properties": {
        "inquiry_id": {
            "type": "string",
            "minLength": 1
        },
        "task_id": {
            "type": "string",
            "minLength": 1
        },
        "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "type",
                    "question_text",
                    "response_text"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "clarification",
                            "assumption",
                            "reason-evidence",
                            "viewpoint",
                            "implication",
                            "meta"
                        ]
                    },
                    "question_text": {
                        "type": "string",
                        "minLength": 1
                    },
                    "response_text": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "additionalProperties": false
            }
        },
        "clarity_score_before": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
        },
        "clarity_score_after": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
        },
        "timestamp": {
            "type": "string",
            "minLength": 1
        }
    },
    "additionalProperties": false
}