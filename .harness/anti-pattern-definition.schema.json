{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HELab Anti-Pattern Definition",
    "type": "object",
    "required": [
        "id",
        "name",
        "description",
        "canonical_form",
        "detection_rule",
        "refactor_suggestion",
        "added_date",
        "audit_enforcement_hook"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^AP-\\d+$"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "canonical_form": {
            "type": "string",
            "minLength": 1
        },
        "detection_rule": {
            "type": "string",
            "minLength": 1
        },
        "refactor_suggestion": {
            "type": "string",
            "minLength": 1
        },
        "added_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "audit_enforcement_hook": {
            "type": "string",
            "minLength": 1
        }
    },
    "additionalProperties": false
}