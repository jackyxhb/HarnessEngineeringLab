{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HELab Requirement Entry",
    "type": "object",
    "required": [
        "id",
        "title",
        "narrative",
        "acceptance_criteria",
        "status",
        "source"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[A-Z]{2,}-R\\d{3}$|^REQ-\\d+$"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "applies_to": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "narrative": {
            "type": "string",
            "minLength": 1
        },
        "acceptance_criteria": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "minItems": 1
        },
        "status": {
            "type": "string",
            "minLength": 1
        },
        "source": {
            "type": "string",
            "minLength": 1
        }
    },
    "additionalProperties": false
}