{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HELab Tool Definition",
    "type": "object",
    "required": [
        "tool_id",
        "purpose",
        "input_shape_summary",
        "output_shape_summary",
        "uniqueness_audit_date"
    ],
    "properties": {
        "tool_id": {
            "type": "string",
            "minLength": 1
        },
        "purpose": {
            "type": "string",
            "minLength": 1
        },
        "input_shape_summary": {
            "type": "string",
            "minLength": 1
        },
        "output_shape_summary": {
            "type": "string",
            "minLength": 1
        },
        "context_cost_tokens": {
            "type": "integer",
            "minimum": 0
        },
        "uniqueness_audit_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
    },
    "additionalProperties": false
}