{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HELab Mailbox Interface Contract",
  "description": "Standardized message contract for P0-10 inter-agent communication. Defines message structure, delivery semantics, and acknowledgment protocol.",
  "type": "object",
  "required": [
    "version",
    "message_id",
    "sender",
    "recipient",
    "type",
    "payload",
    "timestamp"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version"
    },
    "message_id": {
      "type": "string",
      "pattern": "^msg-[a-z0-9]{12}$",
      "description": "Globally unique message identifier"
    },
    "sender": {
      "type": "string",
      "minLength": 1,
      "description": "Sending agent identifier"
    },
    "recipient": {
      "type": "string",
      "description": "Target agent identifier or broadcast selector"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "direct",
        "broadcast",
        "supervisor",
        "tag-filtered"
      ],
      "description": "Delivery mode for this message"
    },
    "type": {
      "type": "string",
      "enum": [
        "task-claim",
        "task-completion",
        "status-update",
        "error-notification",
        "progress-report",
        "idle-signal",
        "control-directive",
        "coordination-request",
        "ack"
      ],
      "description": "Message category"
    },
    "threadId": {
      "type": ["string", "null"],
      "description": "Conversation thread identifier for message correlation"
    },
    "payload": {
      "type": "object",
      "description": "Message content (structure depends on message type)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when message was created"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal",
      "description": "Message priority for delivery ordering"
    },
    "ack_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether sender expects acknowledgment"
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 3,
      "description": "Maximum delivery retry attempts"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Current retry attempt number"
    },
    "delivery_deadline_seconds": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Timeout for delivery (null = no deadline)"
    },
    "message_count_limit_per_task": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Max messages allowed per task to prevent ping-pong loops (per P0-10 prevention rule)"
    },
    "current_message_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of messages sent in current task context"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered",
        "acknowledged",
        "failed",
        "expired"
      ],
      "default": "pending",
      "description": "Current delivery state"
    },
    "delivery_timestamp": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When message was delivered to recipient"
    },
    "acknowledgment_details": {
      "type": ["object", "null"],
      "properties": {
        "ack_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "ack_agent_id": {
          "type": "string"
        },
        "ack_status": {
          "type": "string",
          "enum": ["delivered", "processed", "failed"]
        }
      },
      "description": "Acknowledgment record if ack_required was true"
    },
    "structured_objective": {
      "type": ["object", "null"],
      "description": "For progress-report and status-update messages, structured objective update",
      "properties": {
        "objective_summary": { "type": "string" },
        "progress_percent": { "type": "number" },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "target_agent_types": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "For broadcast messages, filter agents by type tag"
    },
    "tags": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Custom tags for message filtering and routing"
    }
  },
  "additionalProperties": false
}
