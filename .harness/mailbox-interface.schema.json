{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mailbox Interface",
  "description": "Schema for inter-agent mailbox messaging (deferred to Tranche 4)",
  "type": "object",
  "properties": {
    "message_id": { "type": "string" },
    "from_agent": { "type": "string" },
    "to_agent": { "type": "string" },
    "message_count_limit_per_task": { "type": "integer" }
  },
  "required": ["message_id", "from_agent"],
  "additionalProperties": false
}
