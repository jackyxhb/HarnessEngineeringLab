{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Bounded Autonomy Policy",
    "description": "Machine-readable policy for privilege escalation, prompt injection, and data leakage prevention",
    "type": "object",
    "required": [
        "version",
        "policy_id",
        "effective_date",
        "privilege_escalation_rules",
        "prompt_injection_rules",
        "data_leakage_rules"
    ],
    "properties": {
        "version": {
            "type": "integer",
            "minimum": 1
        },
        "policy_id": {
            "type": "string",
            "pattern": "^BP-\\d{4}$"
        },
        "effective_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "privilege_escalation_rules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "rule_id",
                    "description",
                    "enforcement_level",
                    "allowed_operations",
                    "forbidden_operations",
                    "approval_required"
                ],
                "properties": {
                    "rule_id": {
                        "type": "string",
                        "pattern": "^PES-\\d+$"
                    },
                    "description": {
                        "type": "string"
                    },
                    "enforcement_level": {
                        "type": "string",
                        "enum": ["read-only", "file-creation", "code-execution", "deployment"]
                    },
                    "allowed_operations": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "forbidden_operations": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "approval_required": {
                        "type": "boolean"
                    },
                    "monitoring_enabled": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": false
            }
        },
        "prompt_injection_rules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "rule_id",
                    "pattern",
                    "description",
                    "detection_method",
                    "action"
                ],
                "properties": {
                    "rule_id": {
                        "type": "string",
                        "pattern": "^PIR-\\d+$"
                    },
                    "pattern": {
                        "type": "string",
                        "description": "Regex or string pattern to detect injection attempts"
                    },
                    "description": {
                        "type": "string"
                    },
                    "detection_method": {
                        "type": "string",
                        "enum": ["regex", "semantic-analysis", "token-inspection", "entropy-check"]
                    },
                    "action": {
                        "type": "string",
                        "enum": ["block", "alert", "sanitize", "escalate"]
                    },
                    "severity": {
                        "type": "string",
                        "enum": ["critical", "high", "medium", "low"]
                    }
                },
                "additionalProperties": false
            }
        },
        "data_leakage_rules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "rule_id",
                    "data_type",
                    "description",
                    "detection_method",
                    "action"
                ],
                "properties": {
                    "rule_id": {
                        "type": "string",
                        "pattern": "^DLR-\\d+$"
                    },
                    "data_type": {
                        "type": "string",
                        "enum": ["api-key", "secret", "pii", "credential", "token", "password"]
                    },
                    "description": {
                        "type": "string"
                    },
                    "detection_method": {
                        "type": "string",
                        "enum": ["pattern-match", "entropy-analysis", "regex", "semantic-scan"]
                    },
                    "action": {
                        "type": "string",
                        "enum": ["block", "redact", "quarantine", "alert"]
                    },
                    "severity": {
                        "type": "string",
                        "enum": ["critical", "high", "medium", "low"]
                    },
                    "notification_required": {
                        "type": "boolean"
                    }
                },
                "additionalProperties": false
            }
        },
        "audit_trail": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "log_location": {
                    "type": "string"
                },
                "retention_days": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        }
    },
    "additionalProperties": false
}
