{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HELab Skill Manifest",
    "type": "object",
    "required": [
        "skill_id",
        "version",
        "mandatory_read_budget_lines",
        "modes"
    ],
    "properties": {
        "skill_id": {
            "type": "string",
            "minLength": 1
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "mandatory_read_budget_lines": {
            "type": "integer",
            "minimum": 1
        },
        "modes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "routing_keywords"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "routing_keywords": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "minItems": 1
                    },
                    "time_estimate_ms": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "additionalProperties": false
            }
        },
        "templates": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    },
    "additionalProperties": false
}